# You do NOT need any of this to run locally in VS Code.
# These are the environment variables the server understands.
# On Render, set them in the dashboard (Environment tab).

# Secret used to sign login tokens. Use a long random string in production.
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Port (Render sets this automatically)
PORT=4000

# Where users, projects and saved code live. Put this on a persistent disk in production.
# DATA_DIR=/var/data

# Only needed if the React client is hosted on a different site (e.g. Vercel).
# Comma separated list of allowed origins.
# CLIENT_ORIGIN=https://your-app.vercel.app

# Compiler commands (defaults shown). Change them if your machine uses other names.
# PYTHON_CMD=python3        # on Windows the default is "python"
# GCC_CMD=gcc
# GPP_CMD=g++
# JAVAC_CMD=javac
# JAVA_CMD=java

# Limits for each run
# RUN_TIMEOUT_MS=5000
# COMPILE_TIMEOUT_MS=20000
